<header class="listing-header"><nav class="breadcrumbs" aria-label="当前位置"><a href="<%= url_for('') %>">知识库</a><%- wiki_icon('chevron') %><span><%= page.category ? '分类' : page.tag ? '标签' : '笔记索引' %></span></nav><h1 id="article-title"><%= page.category ? wiki_label(page.category) : page.tag || '全部笔记' %></h1><p><%= page.posts ? page.posts.length : 0 %> 篇笔记</p></header>
<div class="note-list"><% if (page.posts) { page.posts.each(function(post) { %><article class="note-list-item"><div><a class="note-title" href="<%= url_for(post.path) %>"><%= wiki_title(post) %></a><p><%= wiki_plain(post.more || post.content).slice(0, 130) %></p></div><time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY-MM-DD') %></time></article><% }); } %></div>
<% if (page.total > 1) { %><nav class="pagination" aria-label="笔记分页"><%- paginator({ prev_text: '上一页', next_text: '下一页' }) %></nav><% } %>
