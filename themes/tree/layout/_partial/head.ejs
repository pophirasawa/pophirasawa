<head>
	<meta http-equiv="content-type" content="text/html; charset=utf-8">
	<meta content="width=device-width, initial-scale=1.0" name="viewport">
	
	<!-- title -->
	<% 
		var title = page.title; 
		if ( title == '' ) {
			var title = page.slug.split("/")[page.slug.split("/").length-1]
		}else {
			var title = page.title; 
		};
	%>
	<title>
	<% if (title){ %>
		<%= title %> | 
	<% } %> 
	<%= config.title %>
	</title>
	
	<!-- keywords,description -->
	<% if (page.keywords){ %>
		<meta name="keywords" content="<%= page.keywords %>,<%= config.keywords %>" />
	<% } else if (config.keywords){ %>
		<meta name="keywords" content="<%= config.keywords %>" />
	<% } %>
	<% if (page.description){ %>
		<meta name="description" content="<%= page.description %>" />
	<% } else if (config.description){ %>
		<meta name="description" content="<%= config.description %>" />
	<% } %>

	<!-- favicon -->
	<% if (theme.favicon){ %>
	<%- favicon_tag(theme.favicon) %>
	<% } %>




	<%- css('css/main.css') %>
	<link rel="stylesheet" href="/vendor/font-awesome/css/font-awesome.min.css">
	<link rel="stylesheet" href="/vendor/highlight/darcula.css">
	<link rel="stylesheet" href="/vendor/fancybox/jquery.fancybox.min.css">
	<link rel="stylesheet" href="/vendor/katex/katex.min.css">
	<script src="/vendor/jquery/jquery.min.js"></script>
	<script src="/vendor/fancybox/jquery.fancybox.min.js"></script>
	<%- js('js/main.js') %>
	<script src="/vendor/katex/copy-tex.min.js" defer></script>
	<script src="/vendor/diagrams.js" defer></script>

	<% if (theme.valine){ %>
		<script src="/vendor/leancloud/av-min.js"></script>
		<script src="/vendor/valine/Valine.min.js"></script>
	<% } %>
	<% if (theme.busuanzi){ %>
		<script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
	<% } %>

</head>