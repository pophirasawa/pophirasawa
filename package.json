{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/build.cjs",
    "check": "node tools/check.cjs",
    "test": "node --test tools/check-wiki.test.cjs",
    "clean": "node tools/clean.cjs",
    "server": "node tools/serve.cjs",
    "new": "hexo new",
    "new:wiki": "hexo --config _config_wiki.yml new",
    "draft": "hexo new draft",
    "publish": "hexo publish",
    "vendor": "node tools/vendor.cjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "@fancyapps/fancybox": "3.5.7",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@vscode/markdown-it-katex": "1.1.2",
    "animejs": "3.2.2",
    "esbuild": "0.28.2",
    "font-awesome": "4.7.0",
    "hexo": "8.1.2",
    "hexo-filter-mermaid-diagrams": "1.0.5",
    "hexo-front-matter": "4.2.1",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index-pin-top": "0.2.2",
    "hexo-generator-json-content": "4.2.3",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-pug": "3.0.0",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-util": "3.3.0",
    "hexo-wordcount": "6.0.1",
    "highlight.js": "11.11.1",
    "jquery": "3.7.1",
    "katex": "0.19.0",
    "leancloud-storage": "3.15.0",
    "markdown-it": "14.3.2",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-deflist": "3.0.0",
    "markdown-it-emoji": "2.0.2",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-ins": "3.0.1",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "mermaid": "12.1.0",
    "uslug": "1.0.4",
    "valine": "1.5.3",
    "velocity-animate": "1.5.2"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "katex": "$katex"
  }
}
